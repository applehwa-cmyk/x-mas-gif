rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /christmasRooms/{code} {
   allow get: if request.auth != null && (resource.data.host == request.auth.uid || request.auth.uid in resource.data.memberUids);
   allow list, create, update, delete: if false;
  }
  match /christmasSecrets/{code} { allow read, write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
